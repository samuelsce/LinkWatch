# Local development only. Replace credentials for any hosted database.
DATABASE_URL="postgresql://linkwatch:linkwatch@localhost:5432/linkwatch?schema=public"

# Give each worker process its own stable identifier in production.
WORKER_ID="local-worker"

# Generate AUTH_SECRET with: node scripts/setup-local-env.mjs
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Enable only when the deployment host/proxy is controlled by you.
AUTH_TRUST_HOST="false"

MONITOR_LIMIT="10"
