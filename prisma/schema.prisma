generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum MonitorStatus {
  UNKNOWN
  ONLINE
  UNSTABLE
  OFFLINE
  PAUSED
}

enum CheckState {
  QUEUED
  RUNNING
  COMPLETED
}

enum CheckOutcome {
  SUCCESS
  FAILURE
  COLLECTOR_ERROR
  BLOCKED
}

enum IncidentEndReason {
  RECOVERED
  CONFIG_CHANGED
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime? @db.Timestamptz(3)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  accounts      Account[]
  sessions      Session[]
  monitors      Monitor[]
  statusPage    StatusPage?
}

// Reserved for the standard Auth.js Prisma adapter. OAuth is implemented in M1.
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

model Monitor {
  id                  String        @id @default(uuid()) @db.Uuid
  ownerId             String        @db.Uuid
  name                String        @db.VarChar(80)
  url                 String        @db.VarChar(2048)
  expectedStatus      Int           @default(200)
  intervalSeconds     Int           @default(300)
  timeoutMs           Int           @default(10000)
  enabled             Boolean       @default(true)
  status              MonitorStatus @default(UNKNOWN)
  configRevision      Int           @default(1)
  consecutiveFailures Int           @default(0)
  firstFailureAt      DateTime?     @db.Timestamptz(3)
  lastCompletedAt     DateTime?     @db.Timestamptz(3)
  nextCheckAt         DateTime      @default(now()) @db.Timestamptz(3)
  leaseToken          String?       @db.Uuid
  leaseUntil          DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  owner               User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  checks              CheckRun[]
  incidents           Incident[]
  statusPages         StatusPageMonitor[]

  @@unique([id, ownerId])
  @@index([ownerId, createdAt])
  // A partial scheduling index is added by the SQL constraints migration.
}

model CheckRun {
  id           String        @id @default(uuid()) @db.Uuid
  monitorId    String        @db.Uuid
  scheduledAt  DateTime      @db.Timestamptz(3)
  revision     Int
  startedAt    DateTime?     @db.Timestamptz(3)
  completedAt  DateTime?     @db.Timestamptz(3)
  state        CheckState    @default(QUEUED)
  leaseToken   String?       @db.Uuid
  leaseUntil   DateTime?     @db.Timestamptz(3)
  attemptCount Int           @default(0)
  outcome      CheckOutcome?
  httpStatus   Int?
  latencyMs    Int?
  errorCode    String?       @db.VarChar(80)
  monitor      Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([monitorId, scheduledAt])
  @@index([monitorId, completedAt(sort: Desc)])
  @@index([completedAt])
  @@index([state, leaseUntil])
}

model Incident {
  id          String             @id @default(uuid()) @db.Uuid
  monitorId   String             @db.Uuid
  startedAt   DateTime           @db.Timestamptz(3)
  confirmedAt DateTime           @db.Timestamptz(3)
  endedAt     DateTime?          @db.Timestamptz(3)
  endReason   IncidentEndReason?
  failureCode String             @db.VarChar(80)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  monitor     Monitor            @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, startedAt(sort: Desc)])
  // SQL enforces at most one open incident per monitor.
}

model StatusPage {
  id          String              @id @default(uuid()) @db.Uuid
  ownerId     String              @unique @db.Uuid
  slug        String              @unique @db.VarChar(80)
  title       String              @db.VarChar(120)
  description String?             @db.VarChar(500)
  published   Boolean             @default(false)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  monitors    StatusPageMonitor[]

  @@unique([id, ownerId])
}

model StatusPageMonitor {
  statusPageId String     @db.Uuid
  monitorId    String     @db.Uuid
  ownerId      String     @db.Uuid
  publicName   String     @db.VarChar(80)
  position     Int        @default(0)
  statusPage   StatusPage @relation(fields: [statusPageId, ownerId], references: [id, ownerId], onDelete: Cascade)
  monitor      Monitor    @relation(fields: [monitorId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@id([statusPageId, monitorId])
  @@index([monitorId, ownerId])
}

model WorkerHeartbeat {
  workerId   String   @id @db.VarChar(100)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  version    String   @db.VarChar(40)
}

model MaintenanceLease {
  name      String   @id @db.VarChar(80)
  token     String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
}
